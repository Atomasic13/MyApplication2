# Copy this file to .env and fill in your values.
# Get free Alpaca keys at https://alpaca.markets → create account → Paper Trading → API Keys

ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# true = paper money (safe), false = real money
PAPER_TRADING=true

# Which stock to trade
SYMBOL=AAPL

# Dollars to spend per buy order (fractional shares — $1 works)
TRADE_AMOUNT=1.00

# How often to check for a signal (seconds)
CHECK_INTERVAL=60
